# ─── LinkedIn credentials ────────────────────────────────────────────────────
# These are your personal LinkedIn login credentials.
# ⚠  Keep this file private — never commit the real .env to git.
LINKEDIN_EMAIL=your.email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ─── Anthropic / Claude API ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Hour (0-23, UTC) at which the daily AI scan runs automatically.
DAILY_SCAN_HOUR=8
DAILY_SCAN_MINUTE=0

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
